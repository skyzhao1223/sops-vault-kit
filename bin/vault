#!/usr/bin/env bash
# vault —— 本地加密凭据库的统一入口（人和 AI 共用同一套命令）
#
# 设计要点：
#   1. 解密只依赖 ~/Library/Application Support/sops/age/keys.txt（600 权限），
#      任何密码都不需要出现在命令行、环境变量或对话里。
#   2. 密码类字段被 sops 加密，url/username/note/env/owner 保持明文，
#      所以 `vault ls` / `vault peek` 能在不解密任何密码的前提下给出全貌。
#   3. 所有写操作都改同一个 YAML 文件，改动可 git diff / git 回滚。
set -euo pipefail

VAULT_VERSION="0.4.0"
VAULT_DIR="${VAULT_DIR:-$HOME/Vault}"
SECRETS="${SECRETS_FILE:-$VAULT_DIR/secrets.yaml}"
KEY_MAC="$HOME/Library/Application Support/sops/age/keys.txt"
KEY_XDG="${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt"

# ---- 密钥定位：优先用户显式指定，其次 macOS 默认路径，再次 XDG 路径 ----
if [ -z "${SOPS_AGE_KEY_FILE:-}" ]; then
  if   [ -f "$KEY_MAC" ]; then export SOPS_AGE_KEY_FILE="$KEY_MAC"
  elif [ -f "$KEY_XDG" ]; then export SOPS_AGE_KEY_FILE="$KEY_XDG"
  fi
fi

die() { printf 'vault: %s\n' "$*" >&2; exit 1; }

# 双语消息层：t <key> [printf 参数...]。VAULT_LANG=en 输出英文，默认中文；
# 字典缺失的 key 原样输出（优雅降级）。错误路径用 die "$(t key args)"。
VAULT_LANG="${VAULT_LANG:-zh}"
t() {
  local key="$1"; shift
  local zh="" en=""
  case "$key" in
    err.no_sops) zh='缺少 sops：brew install sops'; en='sops not found: brew install sops' ;;
    err.no_jq) zh='缺少 jq：brew install jq'; en='jq not found: brew install jq' ;;
    err.no_file) zh='找不到 %s'; en='Not found: %s' ;;
    err.no_key) zh='找不到 age 密钥。已查找: SOPS_AGE_KEY_FILE 环境变量、%s、%s'; en='age key not found. Searched: SOPS_AGE_KEY_FILE env, %s, %s' ;;
    err.no_tpl) zh='缺少模板 %s'; en='Template not found: %s' ;;
    err.stdin_empty) zh='stdin 为空，拒绝写入空值'; en='stdin is empty; refusing to write an empty value' ;;
    err.set_fail) zh='设置失败: %s（sops set 与整文件重建均失败）'; en='Set failed: %s (both sops set and whole-file rebuild failed)' ;;
    err.field_kv) zh='--field 需要 k=v 形式，例如 --field appkey=abc123'; en='--field needs k=v form, e.g. --field appkey=abc123' ;;
    err.gen_name) zh='--gen 需要字段名，例如 --gen appsecret'; en='--gen needs a field name, e.g. --gen appsecret' ;;
    err.unknown_arg) zh='未知参数: %s'; en='Unknown option: %s' ;;
    err.create_fail) zh='创建失败: %s（sops set 与整文件重建均失败）'; en='Create failed: %s (both sops set and whole-file rebuild failed)' ;;
    err.field_fail) zh='字段设置失败: %s'; en='Field set failed: %s' ;;
    err.rm_fail) zh='删除失败（条目或字段不存在？）: %s'; en='Delete failed (entry or field missing?): %s' ;;
    err.same_name) zh='新旧名称相同'; en='Old and new names are identical' ;;
    err.not_found) zh='条目不存在: %s'; en='Entry not found: %s' ;;
    err.exists) zh='目标已存在，拒绝覆盖: %s'; en='Target exists, refusing to overwrite: %s' ;;
    err.rename_fail) zh='重命名失败: %s'; en='Rename failed: %s' ;;
    err.no_clipboard) zh='找不到剪贴板工具（macOS: pbcopy / Wayland: wl-copy / X11: xclip 或 xsel）'; en='No clipboard tool found (macOS: pbcopy / Wayland: wl-copy / X11: xclip or xsel)' ;;
    err.no_totp) zh='%s 里没有存 totp 种子'; en='No totp seed stored for %s' ;;
    err.export_fail) zh='导出失败'; en='Export failed' ;;
    err.reencrypt_fail) zh='重新加密失败，原文件未改动'; en='Re-encryption failed; original file untouched' ;;
    err.reencrypt_mismatch) zh='校验失败：条目数 %s → %s，原文件未改动'; en='Verify failed: entry count %s → %s; original file untouched' ;;
    err.backup_mkdir) zh='无法创建备份目录: %s'; en='Cannot create backup directory: %s' ;;
    err.bundle_fail) zh='创建 bundle 失败'; en='Bundle creation failed' ;;
    err.bundle_verify) zh='备份文件校验失败: %s'; en='Backup verification failed: %s' ;;
    err.bundle_bad) zh='不是有效的 git bundle 或文件已损坏: %s'; en='Not a valid git bundle or file corrupted: %s' ;;
    err.dest_exists) zh='目标目录已存在，拒绝覆盖: %s'; en='Destination exists, refusing to overwrite: %s' ;;
    err.restore_fail) zh='恢复失败'; en='Restore failed' ;;
    err.unknown_cmd) zh='未知命令: %s（运行 vault help 查看用法）'; en='Unknown command: %s (run vault help)' ;;
    err.sort_fail) zh='排序失败'; en='Sort failed' ;;
    set.ok) zh='已设置 %s.%s'; en='Set %s.%s' ;;
    new.ok) zh='已创建 %s'; en='Created %s' ;;
    new.pwgen) zh='已创建 %s（已生成 24 位随机密码，未打印；用 vault copy "%s" 取到剪贴板）'; en='Created %s (24-char random password generated, not printed; retrieve with vault copy "%s")' ;;
    rm.field) zh='已删除 %s.%s'; en='Deleted %s.%s' ;;
    rm.entry) zh='已删除 %s'; en='Deleted %s' ;;
    rename.ok) zh='已重命名 %s → %s'; en='Renamed %s → %s' ;;
    sort.ok) zh='已按名称排序全部条目（%s 条）'; en='Sorted all entries by name (%s)' ;;
    copy.ok) zh='已复制到剪贴板（未打印内容）'; en='Copied to clipboard (not printed)' ;;
    save.none) zh='没有需要提交的改动'; en='Nothing to commit' ;;
    html.ok) zh='已生成明文页面并在浏览器打开：'; en='Plaintext page generated and opened in browser:' ;;
    html.warn) zh='⚠️  看完请关闭标签页，并执行： vault clean'; en='⚠️  Close the tab when done, then run: vault clean' ;;
    clean.ok) zh='已清理 %d 个明文临时文件'; en='Removed %d plaintext temp file(s)' ;;
    export.ok) zh='已导出明文 CSV: %s'; en='Plaintext CSV exported: %s' ;;
    export.warn) zh='⚠️  这是明文文件：导入完成后请立刻 rm 掉，且不要提交到 git。'; en='⚠️  Plaintext file: delete it right after import; never commit to git.' ;;
    kdbx.ok) zh='已导出 KeePassXML: %s'; en='KeePassXML exported: %s' ;;
    kdbx.howto) zh='导入: KeePassXC → 数据库 → 导入 → KeePassXML；KeePassium(iPhone) → 直接打开该文件'; en='Import: KeePassXC → Database → Import → KeePassXML; KeePassium (iPhone) → open the file directly' ;;
    kdbx.warn) zh='⚠️  明文文件（含全部密码），导入完成后立即删除；vault clean 也会清理它'; en='⚠️  Plaintext file (all passwords): delete right after import; vault clean removes it too' ;;
    md.ok) zh='已更新 %s 的自动区块（仅非敏感字段）'; en='Updated the auto block in %s (non-sensitive fields only)' ;;
    reencrypt.ok) zh='已按当前规则重新加密：%s 条记录'; en='Re-encrypted per current rules: %s entries' ;;
    backup.dirty) zh='⚠️  有未提交改动，本次备份只含已提交内容（先 vault save 可全量）'; en='⚠️  Uncommitted changes exist; backup covers committed content only (run vault save first)' ;;
    backup.ok) zh='✓ 已备份: %s'; en='✓ Backed up: %s' ;;
    backup.size) zh='  大小 %s，含全部 git 历史（%s 次提交）'; en='  Size %s, full git history (%s commits)' ;;
    backup.restore) zh='  恢复: vault restore "%s"'; en='  Restore: vault restore "%s"' ;;
    restore.ok) zh='✓ 已恢复到: %s（%s 条记录，解密验证通过）'; en='✓ Restored to: %s (%s entries, decryption verified)' ;;
    restore.use) zh='  直接使用: VAULT_DIR="%s" vault ls'; en='  Use directly: VAULT_DIR="%s" vault ls' ;;
    restore.swap) zh='  或替换旧库: 先把旧 ~/Vault 移走，再 mv "%s" ~/Vault'; en='  Or replace: move the old ~/Vault away, then mv "%s" ~/Vault' ;;
    edit.hint) zh='编辑器: %s（保存并关闭标签页 = 自动重新加密入库）'; en='Editor: %s (save & close the tab = auto re-encrypt)' ;;
    keycard.ok) zh='密钥备份卡已生成并在浏览器打开：'; en='Key backup card generated and opened in browser:' ;;
    keycard.warn) zh='⚠️  卡片含明文私钥：打印 2 份异地保存后，执行 vault clean 删除'; en='⚠️  Card holds the plaintext private key: print 2 copies, store apart, then vault clean' ;;
    *) zh="$key"; en="$key" ;;
  esac
  local fmt="$zh"
  [ "$VAULT_LANG" = "en" ] && fmt="$en"
  printf "$fmt\n" "$@"
}


check() {
  command -v sops >/dev/null 2>&1 || die "$(t err.no_sops)"
  command -v jq   >/dev/null 2>&1 || die "$(t err.no_jq)"
  [ -f "$SECRETS" ] || die "$(t err.no_file "$SECRETS")"
}

check_key() {
  [ -n "${SOPS_AGE_KEY_FILE:-}" ] && [ -f "${SOPS_AGE_KEY_FILE:-}" ] \
    || die "$(t err.no_key "$KEY_MAC" "$KEY_XDG")"
}

# sops 路径语法：每级各自一个方括号，例如 ["systems"]["工作/VPN"]["password"]
# 注意不能写成 JSON 数组 ["systems","工作/VPN","password"]，那会被当成一个畸形键名。
jpath() {
  local out="" a q
  for a in systems "$@"; do
    q="$(jq -Rn --arg v "$a" '$v')"
    out+="[${q}]"
  done
  printf '%s' "$out"
}

# 把任意字符串编码成 JSON 字符串字面量（安全传给 sops set）
jstr() { jq -Rn --arg v "$1" '$v'; }

# 全量解密为 JSON（只在本机管道内流转，不落盘）
sj() { sops decrypt --output-type json "$SECRETS"; }

genpw() {
  LC_ALL=C openssl rand -base64 64 | LC_ALL=C tr -dc 'A-Za-z0-9!@#%^_+=-' | cut -c1-24
}

cmd_ls() {
  local f="${1:-}"
  sj | jq -r --arg f "$f" '
    def d: if (. // "") == "" then "-" else . end;
    .systems // {} | to_entries[]
    | select($f == "" or (.key | test($f; "i")))
    | [ .key, (.value.env|d), (.value.owner|d), (.value.url|d) ]
    | @tsv'
}

# 输出全库 JSON 元数据：明文元数据带值，加密字段只标记 enc:true（不解密，无需密钥）。
# 供 UI 面板与 AI 读取结构；单值明文走 `vault get`。
cmd_meta() {
  python3 - "$SECRETS" <<'PYEOF'
import json, pathlib, re, sys
rows = {}
entry = None
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    if re.match(r'^sops:\s*$', line):
        break
    m = re.match(r'^ {4}([^\s#][^:]*):\s*$', line)
    if m:
        entry = m.group(1).strip(); rows[entry] = {}; continue
    m = re.match(r'^ {8}([^\s#-][^:]*):\s?(.*)$', line)
    if m and entry is not None:
        k = m.group(1).strip(); v = m.group(2).strip()
        if v.startswith('ENC['):
            rows[entry][k] = {'enc': True}
        elif v in ('', '""', "''"):
            rows[entry][k] = {'enc': False, 'value': ''}
        else:
            rows[entry][k] = {'enc': False, 'value': v.strip('"').strip("'")}
print(json.dumps(rows, ensure_ascii=False))
PYEOF
}

# 不解密任何内容，直接从加密文件里读出系统名（纯文本解析，无需密钥）
cmd_peek() {
  awk '
    /^systems:[[:space:]]*$/ { insys = 1; next }
    /^[^[:space:]]/          { insys = 0 }
    insys && /^    [^[:space:]]/ {
      line = $0
      sub(/^    /, "", line)
      sub(/:.*$/, "", line)
      print line
    }' "$SECRETS"
}

_get_raw() {
  local name="${1:?用法: vault get <系统> [字段]}"
  local field="${2:-password}"
  sops decrypt --extract "$(jpath "$name" "$field")" "$SECRETS"
}

cmd_get()  { _get_raw "$@"; echo; }

cmd_show() {
  local name="${1:?用法: vault show <系统>}"
  sops decrypt --extract "$(jpath "$name")" "$SECRETS"
}

# 只报告 stdin 内容的"形状"，绝不输出内容本身（实现在 bin/vault-shape.py）。
# 用途：pbpaste | vault shape —— 入库前体检剪贴板
cmd_shape() {
  python3 "$VAULT_DIR/bin/vault-shape.py"
}

# ---- 明文查看的三个层次（残留面从小到大）----

# ① 明文打到标准输出：不落盘，可直接管给 grep/less/其他命令
cmd_cat() {
  local name="${1:-}"
  check_key
  if [ -n "$name" ]; then
    sops decrypt --extract "$(jpath "$name")" "$SECRETS"
  else
    sops decrypt --output-type yaml "$SECRETS" | awk '/^sops:/{exit} {print}'
  fi
}

# ② 分页器里看：退出后内容从屏幕消失，不留回滚缓冲
cmd_view() {
  local name="${1:-}"
  check_key
  printf '\033[33m⚠️  下面是明文。按 q 退出（退出后内容会从屏幕清除）。\033[0m\n' >&2
  if [ -n "$name" ]; then
    cmd_cat "$name"
  else
    cmd_cat | less -R
  fi
}

# ③ 浏览器卡片视图：分组、全字段、TOTP 实时；会写一个 600 权限的明文临时文件
cmd_html() {
  local tpl="$VAULT_DIR/bin/vault-view.html"
  local out="${1:-/tmp/vault-view-$(date +%Y%m%d-%H%M%S).html}"
  check_key
  [ -f "$tpl" ] || die "$(t err.no_tpl "$tpl")"
  sj | python3 "$VAULT_DIR/bin/vault-render.py" "$tpl" "$VAULT_DIR/.sops.yaml" > "$out"
  chmod 600 "$out"
  if command -v open >/dev/null 2>&1; then open "$out"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$out"
  fi
  t html.ok; printf '  %s\n' "$out"
  t html.warn
}

# 清理所有明文的临时文件（html 视图 / 导出的 CSV）
cmd_clean() {
  local n=0 f
  for f in /tmp/vault-view-*.html /tmp/vault-export-*.csv /tmp/vault-export-*.xml /tmp/vault-keycard-*.html; do
    [ -e "$f" ] || continue
    rm -f "$f"; n=$((n + 1))
  done
  t clean.ok "$n"
}

# 整文件往返：解密 → jq 合并 → 重新加密（明文只经管道与 600 权限临时文件，校验通过才替换）。
# 用途：sops set 的路径导航在个别平台/文件形态下失败（如 Linux 上 systems 为空映射）时的兜底。
_roundtrip_merge() {
  local filter="$1"; shift
  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/vault-rt.XXXXXX")"; chmod 600 "$tmp"
  if ( cd "$VAULT_DIR" \
       && sops decrypt --input-type yaml --output-type json "$SECRETS" 2>/dev/null \
       | jq "$@" "$filter" \
       | sops encrypt --input-type json --output-type yaml --filename-override "$SECRETS" /dev/stdin ) > "$tmp" \
     && sops decrypt --input-type yaml --output-type json "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$SECRETS"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

cmd_set() {
  local name="${1:?用法: vault set <系统> <字段> <值|->}"
  local field="${2:?缺少字段名}"
  local value="${3-}"
  # 值为 "-" 时从 stdin 读取（尾部换行自动剥掉）：
  #   pbpaste | vault set "服务/X" appkey -
  # 用途：让密码值不经过命令行参数、shell 历史和任何日志（进程列表可见参数！）
  if [ "$value" = "-" ]; then
    value="$(cat)"
    [ -n "$value" ] || die "$(t err.stdin_empty)"
  fi
  check_key
  if ! sops set --idempotent "$SECRETS" "$(jpath "$name" "$field")" "$(jstr "$value")" >/dev/null 2>&1; then
    _roundtrip_merge '.systems = (.systems // {}) | .systems[$n] = ((.systems[$n] // {}) + {($f): $v})' \
      --arg n "$name" --arg f "$field" --arg v "$value" \
      || die "$(t err.set_fail "$name.$field")"
  fi
  t set.ok "$name" "$field"
}

cmd_new() {
  local name="${1:?用法: vault new <系统> [--url U] [--username X] [--password P] [--field k=v] [--gen 字段] [--no-password] [--env E] [--owner O] [--note N]}"
  shift
  local url="" username="" password="" env="" owner="" note="" pw_given=0 no_pw=0
  local kv fk fv
  local ex_keys=() ex_vals=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --url)      url="${2-}";      shift 2 ;;
      --username) username="${2-}"; shift 2 ;;
      --password) password="${2-}"; pw_given=1; shift 2 ;;
      --env)      env="${2-}";      shift 2 ;;
      --owner)    owner="${2-}";    shift 2 ;;
      --note)     note="${2-}";     shift 2 ;;
      --field)
        kv="${2-}"; fk="${kv%%=*}"; fv="${kv#*=}"
        [ "$fk" != "$kv" ] || die "$(t err.field_kv)"
        ex_keys+=("$fk"); ex_vals+=("$fv")
        shift 2 ;;
      --gen)
        fk="${2-}"
        [ -n "$fk" ] || die "$(t err.gen_name)"
        ex_keys+=("$fk"); ex_vals+=("$(genpw)")
        shift 2 ;;
      --no-password) no_pw=1; shift ;;
      *) die "$(t err.unknown_arg "$1")" ;;
    esac
  done
  if [ "$pw_given" -eq 0 ] && [ "$no_pw" -eq 0 ]; then password="$(genpw)"; fi

  check_key
  local k v fail=0 i
  for k in url username password totp token env owner note; do
    case "$k" in
      url)      v="$url" ;;
      username) v="$username" ;;
      password) if [ "$no_pw" -eq 1 ]; then continue; fi; v="$password" ;;
      totp)     v="" ;;
      token)    v="" ;;
      env)      v="$env" ;;
      owner)    v="$owner" ;;
      note)     v="$note" ;;
    esac
    sops set --idempotent "$SECRETS" "$(jpath "$name" "$k")" "$(jstr "$v")" >/dev/null 2>&1 || { fail=1; break; }
  done
  if [ "$fail" -eq 1 ]; then
    # 兜底：整文件往返，一次性建出整条记录
    _roundtrip_merge '
      .systems = (.systems // {})
      | .systems[$n] = ({url:$url, username:$u, env:$e, owner:$o, note:$note, totp:"", token:""}
                        + (if $p == "" then {} else {password:$p} end))
    ' --arg n "$name" --arg url "$url" --arg u "$username" \
      --arg p "$( [ "$no_pw" -eq 1 ] && printf '' || printf '%s' "$password" )" \
      --arg e "$env" --arg o "$owner" --arg note "$note" \
      || die "$(t err.create_fail "$name")"
  fi
  # 追加自定义字段（--field/--gen），同样带兜底
  for i in ${ex_keys+"${!ex_keys[@]}"}; do
    if ! sops set --idempotent "$SECRETS" "$(jpath "$name" "${ex_keys[$i]}")" "$(jstr "${ex_vals[$i]}")" >/dev/null 2>&1; then
      _roundtrip_merge '.systems = (.systems // {}) | .systems[$n] = ((.systems[$n] // {}) + {($f): $v})' \
        --arg n "$name" --arg f "${ex_keys[$i]}" --arg v "${ex_vals[$i]}" \
        || die "$(t err.field_fail "${ex_keys[$i]}")"
    fi
  done

  if [ "$no_pw" -eq 0 ] && [ "$pw_given" -eq 0 ]; then
    t new.pwgen "$name" "$name"
  else
    t new.ok "$name"
  fi
}
cmd_rm() {
  local name="${1:?用法: vault rm <系统> [字段]}"
  local field="${2:-}"
  check_key
  local target
  if [ -n "$field" ]; then target="$(jpath "$name" "$field")"; else target="$(jpath "$name")"; fi
  if ! sops unset --idempotent "$SECRETS" "$target" >/dev/null 2>&1; then
    die "$(t err.rm_fail "$name${field:+.$field}")"
  fi
  if [ -n "$field" ]; then t rm.field "$name" "$field"
  else t rm.entry "$name"; fi
}

# 重命名条目（sops 无原生 rename：整文件往返搬移子树，校验后原子替换）
cmd_rename() {
  local old="${1:?用法: vault rename <旧系统名> <新系统名>}"
  local new="${2:?缺少新系统名}"
  [ "$old" != "$new" ] || die "$(t err.same_name)"
  cmd_peek | grep -Fxq "$old" || die "$(t err.not_found "$old")"
  if cmd_peek | grep -Fxq "$new"; then die "$(t err.exists "$new")"; fi
  check_key
  _roundtrip_merge '.systems = (.systems // {}) | .systems[$new] = .systems[$old] | del(.systems[$old])' \
    --arg old "$old" --arg new "$new" || die "$(t err.rename_fail "$old")"
  cmd_md >/dev/null 2>&1 || true
  t rename.ok "$old" "$new"
}

cmd_copy() {
  local copier=""
  if   command -v pbcopy  >/dev/null 2>&1; then copier="pbcopy"
  elif command -v wl-copy >/dev/null 2>&1; then copier="wl-copy"
  elif command -v xclip   >/dev/null 2>&1; then copier="xclip -selection clipboard"
  elif command -v xsel    >/dev/null 2>&1; then copier="xsel -b"
  else die "$(t err.no_clipboard)"
  fi
  _get_raw "$1" "${2:-password}" | $copier
  t copy.ok
}

# 只在非敏感字段里搜索：系统名 / url / username / note / env / owner
cmd_search() {
  local kw="${1:?用法: vault search <关键词>}"
  sj | jq -r --arg f "$kw" '
    def d: if (. // "") == "" then "-" else . end;
    .systems // {} | to_entries[]
    | select(([ .key, (.value.url//""), (.value.username//""),
               (.value.note//""), (.value.env//""), (.value.owner//"") ] | join(" "))
             | test($f; "i"))
    | [ .key, (.value.username|d), (.value.url|d), (.value.note|d) ]
    | @tsv'
}

# 反向查询：某个密码/令牌用在了哪个系统（只输出系统名，不输出密文）
cmd_find_secret() {
  local kw="${1:?用法: vault find-secret <片段>}"
  sj | jq -r --arg f "$kw" '
    .systems // {} | to_entries[]
    | select([ .value | to_entries[] | select(.value | type == "string") | .value ] | join(" ") | test($f; "i"))
    | .key'
}

cmd_totp() {
  local name="${1:?用法: vault totp <系统>}"
  local seed
  seed="$(_get_raw "$name" totp)"
  [ -n "$seed" ] || die "$(t err.no_totp "$name")"
  python3 - "$seed" <<'PY'
import sys, base64, hmac, hashlib, struct, time
s = sys.argv[1].strip().replace(" ", "").replace("-", "").upper()
try:
    key = base64.b32decode(s + "=" * (-len(s) % 8))
except Exception as e:
    sys.exit(f"totp: 种子不是合法 base32: {e}")
step = 30
c = int(time.time()) // step
h = hmac.new(key, struct.pack(">Q", c), hashlib.sha1).digest()
o = h[-1] & 0x0F
code = (struct.unpack(">I", h[o:o+4])[0] & 0x7FFFFFFF) % 1000000
print(f"{code:06d}   剩余 {step - int(time.time()) % step}s")
PY
}

# 导出明文 CSV（给手机端密码管理器导入用）。默认写到 600 权限的临时文件。
cmd_export() {
  local out="${1:-/tmp/vault-export-$(date +%Y%m%d-%H%M%S).csv}"
  sj | jq -r '
    .systems // {} | to_entries[]
    | [ .key, (.value.url//""), (.value.username//""), (.value.password//""),
        ((.value.note//"") | gsub("[\r\n]+"; " ")) ]
    | @csv' > "$out"
  chmod 600 "$out"
  t export.ok "$out"
  t export.warn
}

# 导出 KeePassXML（明文 XML！）：给 KeePassXC / KeePassium（iPhone）导入用。
# 这是"手机也能用"的官方路线：权威源仍是本库，导出的是快照。
cmd_kdbx() {
  check_key
  local out="${1:-/tmp/vault-export-$(date +%Y%m%d-%H%M%S).xml}"
  sj | python3 "$VAULT_DIR/bin/vault-kdbx.py" > "$out" || { rm -f "$out"; die "$(t err.export_fail)"; }
  chmod 600 "$out"
  t kdbx.ok "$out"
  t kdbx.howto
  t kdbx.warn
}

# 用非敏感字段重新生成 systems.md 里的自动区块
cmd_md() {
  local md="$VAULT_DIR/systems.md" tmp rowsf
  [ -f "$md" ] || die "$(t err.no_file "$md")"
  rowsf="$(mktemp)"; tmp="$(mktemp)"
  sj | jq -r '
    def d: if (. // "") == "" then "-" else . end;
    (.systems // {} | to_entries | sort_by(.key))[]
    | [ .key, (.value.url|d), (.value.env|d), (.value.owner|d), (.value.note|d) ]
    | @tsv' | awk -F'\t' '{printf "| %s | %s | %s | %s | %s |\n", $1, $2, $3, $4, $5}' > "$rowsf"
  awk -v rf="$rowsf" '
    /<!-- BEGIN AUTO -->/ {
      print
      print "| 系统 | 入口地址 | 环境 | 负责人 | 备注 |"
      print "|---|---|---|---|---|"
      while ((getline line < rf) > 0) print line
      close(rf)
      skip = 1; next
    }
    /<!-- END AUTO -->/ { skip = 0 }
    !skip               { print }' "$md" > "$tmp"
  mv "$tmp" "$md"; rm -f "$rowsf"
  t md.ok "$md"
}

# 检查加密后的文件：确认敏感字段真的没有以明文存在（不需要 age 密钥）
cmd_audit() {
  python3 "$VAULT_DIR/bin/vault-audit.py" "$VAULT_DIR/.sops.yaml" "$SECRETS"
}

# 按当前 .sops.yaml 重新加密整个库。
# 注意：sops updatekeys 不会重新应用改过的 encrypted_regex，必须走这条路。
# 明文全程只在管道里流转，不落盘；校验通过后才替换原文件。
cmd_reencrypt() {
  check_key
  local tmp before after
  before="$(sj | jq -r '.systems // {} | length')"
  tmp="$(mktemp "${TMPDIR:-/tmp}/vault-reencrypt.XXXXXX")"
  if ! ( cd "$VAULT_DIR" \
         && sops decrypt --input-type yaml --output-type yaml "$SECRETS" \
         | sops encrypt --input-type yaml --output-type yaml --filename-override "$SECRETS" /dev/stdin ) > "$tmp"; then
    rm -f "$tmp"; die "$(t err.reencrypt_fail)"
  fi
  after="$(sops decrypt --input-type yaml --output-type json "$tmp" 2>/dev/null | jq -r '.systems // {} | length')"
  if [ "$after" != "$before" ]; then
    rm -f "$tmp"; die "$(t err.reencrypt_mismatch "$before" "${after:-?}")"
  fi
  chmod 600 "$tmp"; mv "$tmp" "$SECRETS"
  t reencrypt.ok "$after"
}

# ---- 备份与恢复 ----

# 把整个库（含全部 git 历史）打成一个 bundle 文件备份。
# bundle 里敏感值全是密文；系统名/URL/备注等元数据按设计是明文。
cmd_backup() {
  local dest="${1:-}"
  if [ -z "$dest" ]; then
    local icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
    if [ -d "$icloud" ]; then dest="$icloud/VaultBackups"; else dest="$HOME/VaultBackups"; fi
  fi
  mkdir -p "$dest" || die "$(t err.backup_mkdir "$dest")"
  if [ -n "$(git -C "$VAULT_DIR" status --porcelain)" ]; then
    t backup.dirty >&2
  fi
  local stamp name tmpd tmp
  stamp="$(date +%Y%m%d-%H%M%S)"
  name="vault-$stamp.bundle"
  tmpd="$(mktemp -d)"; tmp="$tmpd/vault.bundle"
  if ! git -C "$VAULT_DIR" bundle create "$tmp" --all; then
    rm -rf "$tmpd"; die "$(t err.bundle_fail)"
  fi
  mv "$tmp" "$dest/$name"; rm -rf "$tmpd"
  git -C "$VAULT_DIR" bundle verify "$dest/$name" >/dev/null 2>&1 || die "$(t err.bundle_verify "$dest/$name")"
  { ls -1t "$dest"/vault-*.bundle 2>/dev/null | tail -n +6 | while read -r f; do rm -f "$f"; done; } || true
  t backup.ok "$dest/$name"
  t backup.size "$(du -h "$dest/$name" | cut -f1)" "$(git -C "$VAULT_DIR" rev-list --count HEAD)"
  t backup.restore "$dest/$name"
}

# 从 bundle 恢复到新目录，绝不覆盖现有库
cmd_restore() {
  local bundle="${1:?用法: vault restore <备份文件.bundle> [目标目录]}"
  local dest="${2:-$HOME/Vault-restored-$(date +%Y%m%d-%H%M%S)}"
  [ -f "$bundle" ] || die "$(t err.no_file "$bundle")"
  # verify 需要 git 仓库上下文；新机器上可能没有 → 用一次性空仓库做校验
  local scratch; scratch="$(mktemp -d)"
  git init -q "$scratch"
  git -C "$scratch" bundle verify "$bundle" >/dev/null 2>&1 || { rm -rf "$scratch"; die "$(t err.bundle_bad "$bundle")"; }
  rm -rf "$scratch"
  [ -e "$dest" ] && die "$(t err.dest_exists "$dest")"
  check_key
  git clone -q "$bundle" "$dest" || die "$(t err.restore_fail)"
  local n
  n="$(sops decrypt --output-type json "$dest/secrets.yaml" 2>/dev/null | jq -r '.systems // {} | length' 2>/dev/null)"
  if [ -z "$n" ] || [ "$n" = "null" ]; then
    die "恢复出来的库无法解密（age 密钥对吗？）——文件保留在 $dest"
  fi
  t restore.ok "$dest" "$n"
  t restore.use "$dest"
  t restore.swap "$dest"
}

# 生成 age 密钥的离线备份卡（HTML，浏览器打开打印）。
# ⚠️ 卡片含明文私钥：应由用户本人运行；打印后用 vault clean 删除。
cmd_keycard() {
  check_key
  local out="${1:-/tmp/vault-keycard-$(date +%Y%m%d-%H%M%S).html}"
  local pub sec keydir
  pub="$(age-keygen -y "$SOPS_AGE_KEY_FILE" 2>/dev/null)" || die "无法从 $SOPS_AGE_KEY_FILE 读出公钥"
  sec="$(grep -o 'AGE-SECRET-KEY-[A-Z0-9]*' "$SOPS_AGE_KEY_FILE" | head -1)"
  [ -n "$sec" ] || die "密钥文件里没找到 age 私钥"
  keydir="$(dirname "$SOPS_AGE_KEY_FILE")"
  local qr_html=""
  if command -v qrencode >/dev/null 2>&1; then
    local qr_b64
    qr_b64="$(qrencode -o - -t PNG "$sec" 2>/dev/null | base64 | tr -d '\n' || true)"
    if [ -n "$qr_b64" ]; then
      qr_html="<p><b>私钥二维码</b>（扫码录入，避免手抄错）：</p><img style=\"width:230px;height:230px;image-rendering:pixelated\" src=\"data:image/png;base64,$qr_b64\" alt=\"age key QR\">"
    fi
  fi
  cat > "$out" <<HTML
<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8"><title>Vault 主密钥备份卡</title>
<style>
body{font:15px/1.6 -apple-system,"PingFang SC",sans-serif;background:#fff;color:#111;max-width:640px;margin:40px auto;padding:0 20px}
h1{font-size:20px} h2{font-size:16px;margin-top:28px}
.card{border:3px solid #111;border-radius:12px;padding:24px;margin:20px 0}
.key{font:15px/1.5 ui-monospace,Menlo,monospace;word-break:break-all;background:#f5f5f5;border:1px dashed #999;padding:12px;border-radius:6px}
.pub{font:12px/1.4 ui-monospace,Menlo,monospace;word-break:break-all;color:#555}
.warn{background:#fff3cd;border:1px solid #e0c060;border-radius:8px;padding:12px;font-size:13.5px}
ol li{margin:6px 0} .sign{margin-top:24px;font-size:13px;color:#555} code{background:#f0f0f0;padding:1px 5px;border-radius:4px;font-size:13px}
@media print{.noprint{display:none}}
</style></head><body>
<h1>🔑 Vault 主密钥离线备份卡</h1>
<p class="warn">任何同时拿到<b>这张卡</b>和你<b>任意一个备份文件</b>（.bundle）的人，都能读出你整个凭据库。请打印 <b>2 份</b>，存放在 <b>2 个不同的物理地点</b>，像保管现金一样。绝不要拍照上传网盘或发到聊天软件。</p>
<div class="card">
<p><b>私钥</b>（恢复用，绝不外传）：</p>
<div class="key">${sec}</div>
${qr_html}
<p><b>公钥</b>（核对密钥用，可公开）：</p>
<div class="pub">${pub}</div>
<p class="sign">生成时间：$(date '+%Y-%m-%d %H:%M') · 机器：$(hostname -s) · 库位置：~/Vault/secrets.yaml</p>
</div>
<h2>恢复步骤（新电脑上）</h2>
<ol>
<li>安装工具：<code>brew install age sops</code>（Linux 用包管理器或官方 release）</li>
<li>重建密钥：<code>mkdir -p "${keydir}"</code>，把上面的私钥单独一行写入 <code>${SOPS_AGE_KEY_FILE}</code>，然后 <code>chmod 600 "${SOPS_AGE_KEY_FILE}"</code></li>
<li>恢复库：<code>vault restore /路径/vault-XXXXXXXX-XXXXXX.bundle</code>（会自动验证能否解密）</li>
</ol>
<p class="noprint">打印完成后，回到终端执行 <code>vault clean</code> 删除磁盘上的本文件。</p>
</body></html>
HTML
  chmod 600 "$out"
  if command -v open >/dev/null 2>&1; then open "$out"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$out"
  fi
  t keycard.ok; printf '  %s\n' "$out"
  t keycard.warn
}

# 整库编辑：sops 官方机制 —— 解密 → 编辑器打开 → 保存退出时自动重新加密。
# 编辑器优先级：$EDITOR → VS Code → Cursor → vim（VS Code/Cursor 用 --wait 阻塞到关标签页）
cmd_edit() {
  local ed="${EDITOR:-}"
  if [ -z "$ed" ]; then
    local code="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
    local cursor="/Applications/Cursor.app/Contents/Resources/app/bin/cursor"
    if   [ -x "$code" ];   then ed="$code --wait"
    elif [ -x "$cursor" ]; then ed="$cursor --wait"
    elif command -v vim >/dev/null 2>&1; then ed="vim"
    else ed="vi"; fi
  fi
  t edit.hint "$ed"
  EDITOR="$ed" sops edit "$SECRETS"
}

cmd_save() {
  git -C "$VAULT_DIR" add -A
  if git -C "$VAULT_DIR" diff --cached --quiet; then
    t save.none; return 0
  fi
  git -C "$VAULT_DIR" commit -q -m "${1:-vault: update $(date '+%Y-%m-%d %H:%M')}"
  git -C "$VAULT_DIR" --no-pager log -1 --stat --oneline
}

cmd_log() {
  git -C "$VAULT_DIR" --no-pager log --oneline -n "${1:-20}"
}

cmd_remote() {
  local url="${1:?用法: vault remote <git 仓库地址>}"
  if git -C "$VAULT_DIR" remote get-url origin >/dev/null 2>&1; then
    git -C "$VAULT_DIR" remote set-url origin "$url"
  else
    git -C "$VAULT_DIR" remote add origin "$url"
  fi
  printf 'origin = %s\n' "$url"
}

cmd_push() { git -C "$VAULT_DIR" push -u origin HEAD; }
cmd_pull() { git -C "$VAULT_DIR" pull --rebase; }

cmd_path() {
  printf 'VAULT_DIR   %s\n' "$VAULT_DIR"
  printf 'SECRETS     %s\n' "$SECRETS"
  printf 'AGE_KEY     %s\n' "${SOPS_AGE_KEY_FILE:-（未找到！）}"
  printf 'SOPS        %s\n' "$(command -v sops || echo '-')"
}

cmd_doctor() {
  local ok=0
  printf '%-14s %s\n' "sops"   "$(command -v sops || { echo '缺失 → brew install sops'; ok=1; })"
  printf '%-14s %s\n' "jq"     "$(command -v jq   || { echo '缺失 → brew install jq';   ok=1; })"
  printf '%-14s %s\n' "python3" "$(command -v python3 || echo '缺失（仅 totp 命令受影响）')"
  if [ -f "${SOPS_AGE_KEY_FILE:-/nonexistent}" ]; then
    printf '%-14s %s\n' "age 密钥" "$SOPS_AGE_KEY_FILE"
    local perm
    case "$(uname -s)" in
      Darwin) perm="$(stat -f '%Lp' "$SOPS_AGE_KEY_FILE" 2>/dev/null || echo '?')" ;;
      *)      perm="$(stat -c '%a' "$SOPS_AGE_KEY_FILE" 2>/dev/null || echo '?')" ;;
    esac
    if [ "$perm" = "600" ]; then printf '%-14s %s\n' "密钥权限" "600 ✓"
    else printf '%-14s %s\n' "密钥权限" "$perm ⚠️ 建议 chmod 600"; fi
  else
    printf '%-14s %s\n' "age 密钥" "未找到 ⚠️（库将无法解密）"; ok=1
  fi
  if sops decrypt --output-type json "$SECRETS" >/dev/null 2>&1; then
    printf '%-14s %s\n' "解密自检" "通过 ✓"
    printf '%-14s %s 条\n' "系统数量" "$(sj | jq -r '.systems|length')"
  else
    printf '%-14s %s\n' "解密自检" "失败 ✗"; ok=1
  fi
  if [ -n "$(git -C "$VAULT_DIR" status --porcelain)" ]; then
    printf '%-14s %s\n' "git" "有未提交改动 → vault save"
  else
    printf '%-14s %s\n' "git" "干净 ✓"
  fi
  local bdir="$HOME/Library/Mobile Documents/com~apple~CloudDocs/VaultBackups"
  [ -d "$bdir" ] || bdir="$HOME/VaultBackups"
  local latest
  latest="$(ls -1t "$bdir"/vault-*.bundle 2>/dev/null | head -1 || true)"
  if [ -n "$latest" ]; then
    printf '%-14s %s\n' "最近备份" "$(basename "$latest")"
  else
    printf '%-14s %s\n' "最近备份" "无 ⚠️ → vault backup"
  fi
  return $ok
}

# 从 CSV 导入（Bitwarden / 1Password / Chrome / 通用 / 本库 export 的格式均可）。
# 已存在的同名条目默认跳过（绝不覆盖）；密码值经 stdin 写入，不进进程参数。
cmd_import() {
  local csv="${1:?用法: vault import <csv 文件> [--format auto|bitwarden|1password|chrome|generic]}"
  local fmt="auto"
  if [ "${2:-}" = "--format" ]; then fmt="${3:-auto}"; fi
  [ -f "$csv" ] || die "找不到 CSV: $csv"
  check_key
  local jsonl; jsonl="$(mktemp "${TMPDIR:-/tmp}/vault-import.XXXXXX")"
  if ! python3 "$VAULT_DIR/bin/vault-import.py" "$csv" "$fmt" > "$jsonl"; then
    rm -f "$jsonl"; die "CSV 解析失败（检查编码/表头，或用 --format 显式指定）"
  fi
  local n=0 skipped=0 line name url user pass totp note
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    name="$(printf '%s' "$line" | jq -r '.name // ""')"
    if [ -z "$name" ]; then skipped=$((skipped+1)); continue; fi
    if cmd_peek | grep -Fxq "$name"; then skipped=$((skipped+1)); continue; fi
    url="$(printf '%s' "$line" | jq -r '.url // ""')"
    user="$(printf '%s' "$line" | jq -r '.username // ""')"
    pass="$(printf '%s' "$line" | jq -r '.password // ""')"
    totp="$(printf '%s' "$line" | jq -r '.totp // ""')"
    note="$(printf '%s' "$line" | jq -r '.note // ""')"
    local args=("$name" --no-password)
    if [ -n "$url" ];  then args+=(--url "$url"); fi
    if [ -n "$user" ]; then args+=(--username "$user"); fi
    if [ -n "$note" ]; then args+=(--note "$note"); fi
    cmd_new "${args[@]}" >/dev/null
    if [ -n "$pass" ]; then printf '%s' "$pass" | cmd_set "$name" password - >/dev/null; fi
    if [ -n "$totp" ]; then printf '%s' "$totp" | cmd_set "$name" totp - >/dev/null; fi
    n=$((n+1))
  done < "$jsonl"
  rm -f "$jsonl"
  cmd_md >/dev/null 2>&1 || true
  printf '✓ 导入 %d 条，跳过 %d 条（已存在或无名）\n' "$n" "$skipped"
  printf '⚠️  源 CSV 是明文，用完立即删除：rm -P "%s"（macOS）或 shred -u\n' "$csv"
}

usage_en() {
  cat <<'EOF'
vault — local encrypted credential store (sops + age + git; free, local, AI-manageable)

Read
  vault ls [filter]            list entries (name / env / owner / url); no decryption
  vault peek                   list entry names straight from the ciphertext (no key needed)
  vault meta                   whole-vault JSON metadata (no decryption; for UI/AI)
  vault show <entry>           one entry in plaintext (careful)
  vault get <entry> [field]    one field value (default: password)
  vault copy <entry> [field]   copy to clipboard, never printed
  vault search <kw>            search names/urls/usernames/notes (never secrets)
  vault find-secret <frag>     reverse lookup: which entries use this secret
  vault totp <entry>           current TOTP code from the stored seed
  vault shape                  report the SHAPE of stdin (length/charset/prefix/sha256)
                               without printing it — clipboard pre-flight check

Plaintext views (smallest footprint first)
  vault cat [entry]            plaintext to stdout (never touches disk)
  vault view [entry]           paged in less (screen cleared on quit)
  vault html [file]            browser card view (grouped, click-to-copy, live TOTP)
  vault clean                  remove plaintext temp files (html/CSV/XML/keycard)

Write
  vault new <entry> [--url U] [--username X] [--password P] [--field k=v]
              [--gen FIELD] [--no-password] [--env E] [--owner O] [--note N]
                               create entry; password auto-generated unless given
  vault set <entry> <field> <value|->
                               set a field; '-' reads the value from stdin
                               (pbpaste | vault set X appkey -  keeps it out of
                                args, history and process listings)
  vault rm <entry> [field]     delete entry or single field
  vault rename <old> <new>     rename entry (verified whole-file round trip)
  vault sort                   sort all entries by name
  vault edit                   edit the whole vault in $EDITOR (sops edit)
  vault import <csv> [--format auto|bitwarden|1password|chrome|generic]
                               bulk import; existing entries skipped
  vault md                     rebuild the auto block of systems.md

Check & maintain
  vault audit                  allowlist/leak audit (works without the key)
  vault reencrypt              re-encrypt after changing .sops.yaml
  vault save [msg]             git commit
  vault log                    change history
  vault remote <git-url>       bind a backup remote (private repo recommended)
  vault push / vault pull      push / pull
  vault export [file]          plaintext CSV export (delete after use)
  vault kdbx [file]            KeePassXML export (KeePassXC / KeePassium)
  vault backup [dir]           single-file git bundle backup (keeps last 5)
  vault restore <bundle> [dir] restore to a NEW directory, verified
  vault keycard [file]         printable offline age-key backup card (then vault clean)
  vault doctor                 self-check (key, perms, decryption, git, last backup)
  vault path / vault version   print locations / version

Environment: VAULT_DIR, SECRETS_FILE, SOPS_AGE_KEY_FILE, VAULT_LANG=zh|en
EOF
}

# 按名称排序全部条目（整文件往返重写；ls/md/面板显示顺序随之稳定）
cmd_sort() {
  check_key
  local n
  n="$(sj | jq -r '.systems // {} | length')"
  _roundtrip_merge '.systems = ((.systems // {}) | to_entries | sort_by(.key) | from_entries)' \
    || die "$(t err.sort_fail)"
  cmd_md >/dev/null 2>&1 || true
  t sort.ok "$n"
}

usage() {
  cat <<'EOF'
vault —— 本地加密凭据库（免费 / 本地 / AI 可管理）

读取
  vault ls [关键词]            列出所有系统（系统名 / 环境 / 负责人 / 入口）
  vault peek                   不解密，直接列出系统名
  vault meta                   全库 JSON 元数据（不解密；明文元数据带值，密钥字段只标 enc）
  vault import <csv> [--format auto|bitwarden|1password|chrome|generic]
                               从 CSV 批量导入（已存在的条目跳过不覆盖）
  vault version                打印版本
  vault shape                  只报告 stdin 内容的形状（长度/行数/构成/前缀/哈希），不输出内容；
                               入库前体检剪贴板：pbpaste | vault shape
  vault show <系统>            显示整条记录（含明文密码，谨慎）
  vault get  <系统> [字段]      取单个字段，默认 password
  vault copy <系统> [字段]      复制到剪贴板，不打印
  vault search <关键词>         搜系统名/入口/用户名/备注（不解密密码）
  vault find-secret <片段>      反查某密码用在哪些系统（只输出系统名）
  vault totp <系统>            用存下的种子算出当前动态验证码

明文查看（残留面从小到大）
  vault cat  [系统]            明文打到标准输出，不落盘；可管道给 grep/less
  vault view [系统]            在 less 里分页看，退出后内容从屏幕清除
  vault html [文件]            生成浏览器卡片视图（分组/全字段/动态码实时刷新/点击复制）
  vault clean                  删除 html 视图和导出 CSV 遗留的明文临时文件

检查与维护
  vault audit                  查加密规则有没有漏网字段、有没有明文存放的密钥
  vault reencrypt              改完 .sops.yaml 后按新规则重新加密整个库

备份与恢复
  vault backup [目录]          整库（含 git 历史）打包成单文件；默认 iCloud Drive/VaultBackups，保留最近 5 份
  vault restore <bundle> [目录] 从备份恢复到新目录，绝不覆盖现有库，自动验证可解密
  vault keycard [文件]         生成 age 密钥离线备份卡（浏览器打印）；⚠️ 含明文私钥，打印后 vault clean

写入
  vault new  <系统> [--url U] [--username X] [--password P] [--env E] [--owner O] [--note N]
                              新建记录；不给 --password 则自动生成 24 位随机密码
  vault set  <系统> <字段> <值|->  设置字段；值为 - 时从 stdin 读（pbpaste | vault set X appkey -，
                                密码不进命令行参数/shell 历史/进程列表）
  vault rm   <系统> [字段]      删除整条或单个字段
  vault rename <旧名> <新名>    重命名条目（整文件往返，目标已存在则拒绝）
  vault sort                   按名称排序全部条目
  vault edit                   整库编辑：VS Code（或 $EDITOR）里改明文 YAML，关掉标签页自动重加密
  vault md                     用非敏感字段重建 systems.md 的自动区块

运维
  vault save [说明]            提交本次改动到 git
  vault log                   查看改动历史
  vault remote <git 地址>      绑定备份仓库（建议私有仓库）
  vault push / vault pull      推 / 拉
  vault export [文件]          导出明文 CSV（给手机端导入，用完即删）
  vault kdbx [文件]            导出 KeePassXML（KeePassXC/KeePassium 导入，含 TOTP，用完即删）
  vault doctor                 自检（密钥、权限、解密、git 状态）
  vault path                   打印库和密钥的位置
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help|-h|--help) if [ "$VAULT_LANG" = "en" ]; then usage_en; else usage; fi; return 0 ;;
    version|-v|--version) printf 'vault %s\n' "$VAULT_VERSION"; return 0 ;;
    path)  cmd_path; return 0 ;;
    doctor) cmd_doctor; return $? ;;
  esac
  check
  case "$cmd" in
    ls|list)   cmd_ls "${1:-}" ;;
    meta)      cmd_meta ;;
    import)    cmd_import "$@" ;;
    shape)     cmd_shape ;;
    peek)      cmd_peek ;;
    show)      cmd_show "$@" ;;
    get)       cmd_get "$@" ;;
    copy|cp)   cmd_copy "$@" ;;
    search|find) cmd_search "$@" ;;
    find-secret) cmd_find_secret "$@" ;;
    totp)      cmd_totp "$@" ;;
    cat)       check_key; cmd_cat "${1:-}" ;;
    view)      check_key; cmd_view "${1:-}" ;;
    html)      cmd_html "${1:-}" ;;
    clean)     cmd_clean ;;
    audit)     cmd_audit ;;
    reencrypt|reenc) cmd_reencrypt ;;
    backup)    cmd_backup "${1:-}" ;;
    restore)   cmd_restore "$@" ;;
    keycard)   cmd_keycard "${1:-}" ;;
    new|add)   cmd_new "$@" ;;
    set)       cmd_set "$@" ;;
    rm|del)    cmd_rm "$@" ;;
    rename|mv) cmd_rename "$@" ;;
    sort)      cmd_sort ;;
    edit)      check_key; cmd_edit ;;
    md)        cmd_md ;;
    save|commit) cmd_save "${1:-}" ;;
    log)       cmd_log "${1:-20}" ;;
    remote)    cmd_remote "$@" ;;
    push)      cmd_push ;;
    pull)      cmd_pull ;;
    export)    check_key; cmd_export "${1:-}" ;;
    kdbx)      cmd_kdbx "${1:-}" ;;
    *) die "$(t err.unknown_cmd "$cmd")" ;;
  esac
}

main "$@"
